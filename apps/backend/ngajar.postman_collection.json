{
  "info": {
    "_postman_id": "ngajar-api-collection-v1",
    "name": "Ngajar (SIAKAD KKA) Backend API",
    "description": "Koleksi lengkap request Postman untuk pengujian API Backend Ngajar (ElysiaJS + Bun).",
