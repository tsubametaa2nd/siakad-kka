# Port Konfigurasi Docker Backend
PORT=4000

# Authentication JWT Secret
AUTH_JWT_SECRET=ganti_dengan_jwt_secret_anda

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# AstraDB (DataStax) Credentials
ASTRA_DB_ENDPOINT=https://your-astra-db-endpoint.apps.astra.datastax.com
ASTRA_DB_TOKEN=AstraCS:your_token_here
ASTRA_DB_KEYSPACE=smkn31

# Google Service Account Credentials
GOOGLE_SA_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Allowed CORS Origins (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS=https://kka.utaaa.my.id,https://kka-fe.vercel.app,http://localhost:5173,http://localhost:3000
